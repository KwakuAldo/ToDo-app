{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "A modern, responsive To Do App built with vanilla JavaScript",
  "main": "index.html",
  "scripts": {
    "dev": "live-server public --port=3000 --open=/",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/css/main.css -o dist/css/main.css",
    "build:js": "webpack --mode=production",
    "watch": "webpack --mode=development --watch",
    "test": "jest",
    "lint": "eslint src/js/**/*.js",
    "format": "prettier --write src/**/*.{js,css,html}"
  },
  "keywords": [
    "todo",
    "javascript",
    "vanilla",
    "web-app"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-loader": "^10.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "live-server": "^1.2.0",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "postcss-preset-env": "^9.3.0",
    "prettier": "^3.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "date-fns": "^2.30.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
